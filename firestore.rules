rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function legacyAdmin() {
      return signedIn() && request.auth.token.email == 'cavictor.franco@gmail.com';
    }

    function legacyEditor() {
      return signedIn() && request.auth.token.email in [
        'advogada1@teste.com',
        'yasmim.ribeiro@apipmcbdf.com.br',
        'marcelledias.adv@gmail.com',
        'grazielasuelimenini2@gmail.com',
        'cavictor.franco@gmail.com',
        'patricia.franco@apipmcbdf.com.br',
        'savina.laila@apipmcbdf.com.br',
        'lorena@apipmcbdf.com.br'
      ];
    }

    function hasUidProfile() {
      return signedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function hasEmailProfile() {
      return signedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.token.email));
    }

    function uidRole() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil;
    }

    function emailRole() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.token.email)).data.perfil;
    }

    function hasAccess() {
      return signedIn() && ((!hasUidProfile() && !hasEmailProfile() && legacyEditor())
        || (hasUidProfile() && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.ativo != false)
        || (!hasUidProfile() && hasEmailProfile() && get(/databases/$(database)/documents/usuarios/$(request.auth.token.email)).data.ativo != false));
    }

    function isAdmin() {
      return (!hasUidProfile() && !hasEmailProfile() && legacyAdmin())
        || (hasUidProfile() && hasAccess() && uidRole() == 'administrador')
        || (!hasUidProfile() && hasEmailProfile() && hasAccess() && emailRole() == 'administrador');
    }

    function canEdit() {
      return (!hasUidProfile() && !hasEmailProfile() && legacyEditor())
        || (hasUidProfile() && hasAccess() && uidRole() in ['administrador', 'editor'])
        || (!hasUidProfile() && hasEmailProfile() && hasAccess() && emailRole() in ['administrador', 'editor']);
    }

    match /pendencias/{caseId} {
      allow read: if hasAccess();
      allow create, update: if canEdit();
      allow delete: if false;

      match /andamentos/{docId} {
        allow read: if hasAccess();
        allow create: if canEdit();
        allow update, delete: if false;
      }

      match /historico/{docId} {
        allow read: if hasAccess();
        allow create: if canEdit();
        allow update, delete: if false;
      }
    }

    match /tipos_caso/{docId} {
      allow read: if hasAccess();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /usuarios/{docId} {
      allow read: if hasAccess();
      allow create, update: if isAdmin();
      // Exclusão de conta/perfil é feita somente pela Cloud Function administrativa.
      allow delete: if false;
    }
  }
}
